[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="SystemFont_Main"]
font_names = PackedStringArray("Noto Sans", "Yu Gothic", "Meiryo", "Noto Sans CJK JP", "Arial")

[sub_resource type="SystemFont" id="SystemFont_Myanmar"]
font_names = PackedStringArray("Myanmar Text", "Noto Sans Myanmar", "Padauk")

[sub_resource type="FontVariation" id="FontVariation_Bilingual"]
fallbacks = Array[Font]([SubResource("SystemFont_Myanmar")])
base_font = SubResource("SystemFont_Main")

[resource]
default_font = SubResource("FontVariation_Bilingual")
default_font_size = 17
