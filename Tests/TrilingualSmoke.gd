extends SceneTree
const Progress = preload("res://GameProgress.gd")
var manager: Node
var report: Dictionary = {}
func _initialize() -> void:call_deferred("_run")
func _wait() -> void:await create_timer(0.25).timeout
func _collect(scene: Node, label: String) -> void:
	var values: Array[String] = []
	for node in scene.find_children("*","Control",true,false):
		if node is Label or node is Button or node is RichTextLabel:
			var value: String = node.text
			if not value.is_empty():values.append(value)
	report[Progress.get_language()+"/"+label]=values
func _run() -> void:
	manager=root.get_node("LocaleManager")
	Progress.reset_progress()
	for language in ["en","mm","jp"]:
		Progress.reset_progress()
		Progress.set_language(language)
		assert(manager.language==language)
		assert(root.title==str(ProjectSettings.get_setting("application/config/name")))
		assert(manager.text("Kitchen Layout Game")=="Kitchen Layout Game")
		assert(manager.text("Kitchen Decoration Game")=="Kitchen Decoration Game")
		assert(manager.text("SETTINGS")=={"en":"Settings","mm":"ဆက်တင်များ","jp":"設定"}[language])
		assert("Mya" in manager.text("Welcome, Mya"))
		assert("5" in manager.text("Stage 5"))
		change_scene_to_file("res://GameMenu.tscn")
		await _wait()
		var menu=current_scene
		var loading_caption=menu.find_child("LoadingCaption",true,false)
		assert(loading_caption!=null and loading_caption.text.begins_with("Loading..."))
		var loader=menu.find_child("KitchenLoadingScreen",true,false)
		assert(loader.get_global_rect().encloses(loading_caption.get_global_rect()))
		assert(loader.find_child("OriginalLoadingKitchen",true,false).texture.resource_path=="res://LoadingAssets/BlueKitchen.png")
		await create_timer(2.2).timeout
		var picker=menu.find_child("LanguageSelectionScreen",true,false)
		assert(picker!=null)
		assert(picker.find_child("LanguageContinue",true,false).text=="Continue   →")
		var choice=picker.find_child("LanguageOption"+language,true,false)
		assert(choice!=null and not choice.disabled)
		choice.pressed.emit()
		picker.find_child("LanguageContinue",true,false).pressed.emit()
		await _wait()
		_collect(menu,"home")
		var home=menu.find_child("KitchenHomeScreen",true,false)
		assert(home.find_child("GameGuide",true,false)==null)
		var language_back=home.find_child("BackToLanguage",true,false)
		assert(language_back!=null and language_back.icon!=null)
		language_back.pressed.emit()
		await _wait()
		picker=menu.find_child("LanguageSelectionScreen",true,false)
		assert(picker!=null)
		assert(picker.find_child("LanguageContinue",true,false).text=="Continue   →")
		picker.find_child("LanguageContinue",true,false).pressed.emit()
		await _wait()
		menu.call("_show_levels")
		await _wait()
		var screen=menu.find_child("LevelSelectionScreen",true,false)
		assert(screen!=null)
		var cards=screen.find_children("StageCard*","Button",true,false)
		assert(cards.size()==10)
		assert(screen.find_children("SelectedPlayButton","Button",true,false).size()==1)
		assert(screen.find_children("SelectedStageGlow","Panel",true,false).size()==1)
		for card in cards:
			assert(card.disabled==(int(card.get_meta("stage"))>3))
			var title=card.find_child("StageTitle",true,false)
			assert(card.find_child("StageSymbol",true,false)!=null)
			assert((card.find_child("StageLock",true,false)!=null)==card.disabled)
			var caption=card.find_child("StageCaption",true,false)
			assert(caption.position.y+caption.size.y<=204)
			assert(title.position.y>=0 and title.position.y+title.size.y<=title.get_parent().size.y+0.1)
			var play=card.find_child("SelectedPlayButton",true,false)
			if play!=null:
				assert(card.size.y-play.position.y-play.size.y>=12)
				assert(caption.position.y+caption.size.y<=play.position.y)
		screen.find_child("StageCard02",true,false).pressed.emit()
		await _wait()
		assert(screen.find_child("StageCard02",true,false).find_child("SelectedPlayButton",true,false)!=null)
		assert(screen.find_children("SelectedPlayButton","Button",true,false).size()==1)
		for button in screen.find_children("*","Button",true,false): assert(button.text!=manager.text("Trainee"))
		var level_back=screen.find_child("BackFromLevels",true,false)
		assert(level_back!=null and level_back.icon!=null)
		level_back.pressed.emit()
		await _wait()
		assert(menu.find_child("KitchenHomeScreen",true,false)!=null)
		menu.call("_show_levels")
		await _wait()
		_collect(menu,"levels")
		for page in ["_show_help","_show_settings","_show_profile","_show_progress","_show_achievements","_show_missions"]:
			menu.call(page)
			await _wait()
			_collect(menu,page)
		# Select a card and launch through its visible Play control.
		menu.call("_show_levels")
		await _wait()
		var level_screen=menu.find_child("LevelSelectionScreen",true,false)
		level_screen.find_child("StageCard01",true,false).pressed.emit()
		await _wait()
		level_screen.find_child("StageCard01",true,false).find_child("SelectedPlayButton",true,false).pressed.emit()
		await _wait()
		var game=current_scene
		assert(game.get("current_lang")==language)
		assert(game.get("canvas")!=null)
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		var customer_name: String = game.get("speaker_name_label").text
		assert(customer_name==manager.text("Ms. Hosokawa"))
		var workspace=game.find_child("Stage1WorkspaceSplit",true,false)
		var customer_card=game.find_child("Stage1CustomerCard",true,false)
		var drawing_card=game.find_child("Stage1DrawingCard",true,false)
		assert(game.find_child("Stage1Header",true,false).size.y<=58)
		assert(game.find_child("Stage1Logo",true,false).texture.resource_path=="res://LoadingAssets/KitchenLogo.webp")
		var avatar=game.find_child("Stage1CustomerAvatar",true,false)
		var stage_one_avatar_size: Vector2 = avatar.size
		var name_plate=game.find_child("Stage1CustomerIdentity",true,false)
		assert(name_plate.global_position.y>=avatar.get_global_rect().end.y)
		assert(name_plate.get_global_rect().encloses(game.get("speaker_name_label").get_global_rect()))
		var request_header=game.find_child("CustomerRequestHeader",true,false)
		assert(request_header.visible)
		assert(request_header.get_global_rect().end.y<=game.get("dialog_bubble").global_position.y)
		for tool in game.find_child("Stage1SixToolGroup",true,false).get_children():
			assert(tool.size.y<=40)
			assert(drawing_card.get_global_rect().encloses(tool.get_global_rect()))
		assert(absf(customer_card.size.x/workspace.size.x-0.35)<0.025)
		assert(not customer_card.get_global_rect().intersects(drawing_card.get_global_rect()))
		for card_name in ["Stage1CustomerCard","Stage1ReferenceCard","Stage1DrawingCard"]:
			assert(game.get_global_rect().encloses(game.find_child(card_name,true,false).get_global_rect()))
		# Exercise the visible Stage 1 controls, including the two distinct Resets.
		var drawing=game.get("canvas")
		var wall=PackedVector2Array([Vector2.ZERO,Vector2(1000,0)])
		drawing.lines.append(wall)
		game.find_child("Stage1ToolUndo",true,false).pressed.emit()
		assert(drawing.lines.is_empty())
		game.find_child("Stage1ToolRedo",true,false).pressed.emit()
		assert(drawing.lines.size()==1)
		drawing.lines.append(wall)
		drawing.selected_line_index=0
		game.find_child("Stage1ToolDelete",true,false).pressed.emit()
		assert(drawing.lines.size()==1)
		game.find_child("Stage1ToolDeleteLast",true,false).pressed.emit()
		assert(drawing.lines.is_empty())
		drawing.lines.append(wall)
		game.find_child("Stage1ToolZoomIn",true,false).pressed.emit()
		assert(drawing.zoom_level>1.0)
		game.find_child("Stage1ToolZoomOut",true,false).pressed.emit()
		assert(is_equal_approx(drawing.zoom_level,1.0))
		drawing.pan=Vector2(200,200)
		game.find_child("Stage1ResetView",true,false).pressed.emit()
		assert(drawing.pan==Vector2(72,60) and drawing.lines.size()==1)
		game.find_child("Stage1ResetDrawing",true,false).pressed.emit()
		assert(drawing.lines.is_empty() and drawing.drawing_enabled)
		game.find_child("Stage1CheckAnswer",true,false).pressed.emit()
		await _wait()
		assert(game.get("last_eval_state")=="wrong")
		assert(game.get("again_button_row").visible)
		for control_name in ["Stage1DrawingToolbar","Stage1ResetDrawing","Stage1CheckAnswer"]:
			var control=game.find_child(control_name,true,false)
			assert(drawing_card.get_global_rect().encloses(control.get_global_rect()))
		assert(drawing_card.get_global_rect().encloses(game.get("again_button").get_global_rect()))
		game.get("again_button").pressed.emit()
		assert(game.get("last_eval_state")=="none" and drawing.drawing_enabled)
		# Language changes must not restore the old, hard-coded customer name.
		game.call("_switch_language","jp" if language!="jp" else "en")
		await _wait()
		assert(game.get("speaker_name_label").text==manager.text("Ms. Hosokawa"))
		game.call("_switch_language",language)
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		assert(game.get("speaker_name_label").text==customer_name)
		_collect(game,"stage1")
		# The real six-wall validator must reject a 1 mm error and accept the exact plan.
		var vertices := [Vector2(0,0),Vector2(7380,0),Vector2(7380,2360),Vector2(7680,2360),Vector2(7680,3400),Vector2(0,3400)]
		drawing.lines.clear()
		for i in range(6): drawing.lines.append(PackedVector2Array([vertices[i],vertices[(i+1)%6]]))
		drawing.lines[0][1].x += 1
		assert(not drawing.analyze_reference())
		drawing.lines[0][1].x -= 1
		assert(drawing.analyze_reference())
		game.call("_confirm")
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		assert(Progress.is_completed(1))
		var complete=game.find_child("Stage1CompleteOverlay",true,false)
		assert(complete!=null and current_scene==game)
		assert(game.get_global_rect().encloses(complete.find_child("MissionCompleteCard",true,false).get_global_rect()))
		if language == "en":
			complete.replay_requested.emit()
			await _wait()
			assert(current_scene==game and game.get("ok_button").text==manager.text("Continue to Stage 2"))
			game.get("ok_button").pressed.emit()
		else:
			complete.next_requested.emit()
		await _wait()
		game=current_scene
		assert(game.get("current_lang")==language)
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		assert(game.get("name_label").text==customer_name)
		var stage_two_avatar: TextureRect = null
		for portrait in game.find_children("*","TextureRect",true,false):
			if portrait.texture!=null and portrait.texture.resource_path=="res://customer_portrait_ui.png":
				stage_two_avatar=portrait
				break
		assert(stage_two_avatar!=null and stage_two_avatar.size==stage_one_avatar_size)
		_collect(game,"stage2")
		var input=game.get("answer_input")
		input.text="PS means Pipe Space."
		await _wait()
		assert(input.text=="PS means Pipe Space.")
		game.call("_check_demo_answer")
		assert(game.get("last_eval_state")=="needs")
		input.text="PS is a vertical shaft for water supply and drainage pipes and cannot easily be moved during renovation."
		game.call("_check_demo_answer")
		assert(game.get("last_eval_state")=="good")
		assert(Progress.is_completed(2))
		assert(game.find_child("ContinueStage3",true,false).is_visible_in_tree())
		await _wait()
		_collect(game,"stage2-correct")
		game.find_child("ContinueStage3",true,false).pressed.emit()
		await _wait()
		game=current_scene
		assert(game.get("current_lang")==language)
		_collect(game,"stage3-q1")
		game.call("_choose",0)
		assert(game.get("step")==0)
		await _wait()
		_collect(game,"stage3-wrong")
		game.call("_choose",2)
		assert(game.get("step")==1)
		game.call("_choose",1)
		await _wait()
		_collect(game,"stage3-parts")
		for panel in game.find_children("*","PanelContainer",true,false):
			if panel.is_visible_in_tree(): assert(game.get_global_rect().encloses(panel.get_global_rect()))
		for i in range(5):
			await _wait()
			var diagram=game.find_child("KitchenPartsDiagram",true,false)
			var click:=InputEventMouseButton.new()
			click.button_index=MOUSE_BUTTON_LEFT
			click.pressed=true
			var zone: Rect2 = diagram.zones[i]
			click.position=(zone.position+zone.size*0.5)*diagram.size/Vector2(650,390)
			diagram.call("_gui_input",click)
		assert(game.get("step")==7)
		assert(Progress.is_completed(3))
		await _wait()
		_collect(game,"stage3-complete")
		assert(Progress.completed_count()==3)
		assert(game.find_child("ResultsTitle",true,false).text==manager.text("Training complete!"))
		assert(game.get_global_rect().encloses(game.find_child("ResultsCard",true,false).get_global_rect()))
	# Reload persisted flags; directly clearing Stage 3 must not claim all missions complete.
	Progress.reset_progress()
	Progress.complete(3)
	Progress._loaded=false
	assert(Progress.completed_count()==1 and Progress.next_stage()==1)
	assert(not Progress.is_completed(1) and not Progress.is_completed(2) and Progress.is_completed(3))
	var partial=load("res://ResultsScreen.gd").new()
	root.add_child(partial)
	await _wait()
	assert(partial.find_child("ResultsTitle",true,false).text==manager.text("Stage 3 complete!"))
	partial.queue_free()
	var file=FileAccess.open("user://translation-audit.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"\t"))
	print("TRILINGUAL_SMOKE_OK: three languages across all menu pages and Stage 1/2/3; ten cards, preserved answer validation and player input")
	quit()
