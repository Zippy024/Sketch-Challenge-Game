extends SceneTree
const Progress = preload("res://GameProgress.gd")
const StageRating = preload("res://StageRating.gd")
var manager: Node
var report: Dictionary = {}
func _initialize() -> void:call_deferred("_run")
func _wait() -> void:await create_timer(0.25).timeout
func _collect(scene: Node, label: String) -> void:
	var values: Array[String] = []
	for node in scene.find_children("*","Control",true,false):
		if node is Label or node is Button or node is RichTextLabel:
			var value: String = node.text
			if not value.is_empty():values.append(value)
	report[Progress.get_language()+"/"+label]=values
func _run() -> void:
	var parts=preload("res://Stage3Assets/Model/JapaneseParts.gd")
	assert(parts.is_correct(0," かうんたー　"))
	assert(parts.is_correct(1,"ｷｯﾁﾝﾎﾞｰﾄﾞ"))
	assert(parts.is_correct(1,"ｷｯﾁﾝﾊﾟﾈﾙ"))
	assert(parts.is_correct(0,"ﾜｰｸﾄｯﾌﾟ"))
	assert(parts.is_correct(2,"ﾚﾝｼﾞﾌｰﾄﾞ"))
	assert(parts.is_correct(3,"こしかべ"))
	assert(parts.is_correct(4,"流し台"))
	assert(parts.NAMES.size()==8)
	assert(parts.is_correct(5,"すいせん") and parts.is_correct(5,"蛇口"))
	assert(parts.is_correct(6,"IHクッキングヒーター") and parts.is_correct(6,"電磁調理器"))
	assert(parts.is_correct(7,"ひきだし") and parts.is_correct(7,"引出し"))
	assert(parts.conversion_candidates("ひきだし")[0]=="引き出し")
	assert(not parts.is_correct(0,"countertop") and not parts.is_correct(0,""))
	assert(parts.needs_conversion("ながしだい") and not parts.needs_conversion("流し台"))
	assert(parts.conversion_candidates("こしかべ")==["腰壁"])
	assert(parts.conversion_candidates("しんく")==["シンク","真紅"])
	assert(StageRating.stars_for(1,150,0)==3)
	assert(StageRating.stars_for(1,480,2)==2)
	assert(StageRating.stars_for(1,700,3)==1)
	assert(StageRating.stars_for(2,181,0)==2)
	manager=root.get_node("LocaleManager")
	Progress.reset_progress()
	for language in ["en","mm","jp"]:
		Progress.reset_progress()
		Progress.set_language(language)
		assert(manager.language==language)
		assert(root.title==str(ProjectSettings.get_setting("application/config/name")))
		assert(manager.text("Kitchen Layout Game")=="Kitchen Layout Game")
		assert(manager.text("Kitchen Decoration Game")=="Kitchen Decoration Game")
		assert(manager.text("SETTINGS")=={"en":"Settings","mm":"ဆက်တင်များ","jp":"設定"}[language])
		assert("Mya" in manager.text("Welcome, Mya"))
		assert("5" in manager.text("Stage 5"))
		change_scene_to_file("res://GameMenu.tscn")
		await _wait()
		var menu=current_scene
		var loading_caption=menu.find_child("LoadingCaption",true,false)
		assert(loading_caption!=null and loading_caption.text.begins_with("Loading..."))
		var loader=menu.find_child("KitchenLoadingScreen",true,false)
		assert(loader.get_global_rect().encloses(loading_caption.get_global_rect()))
		assert(loader.find_child("OriginalLoadingKitchen",true,false).texture.resource_path=="res://LoadingAssets/TealKitchen.webp")
		await create_timer(2.2).timeout
		var picker=menu.find_child("LanguageSelectionScreen",true,false)
		assert(picker!=null)
		assert(picker.find_child("LanguageContinue",true,false).text=="Continue   →")
		var choice=picker.find_child("LanguageOption"+language,true,false)
		assert(choice!=null and not choice.disabled)
		choice.pressed.emit()
		picker.find_child("LanguageContinue",true,false).pressed.emit()
		await _wait()
		_collect(menu,"home")
		var home=menu.find_child("KitchenHomeScreen",true,false)
		var hero=home.find_child("HomeHeroPanel",true,false)
		assert(hero.size.x<home.size.x*0.65 and hero.size.y<home.size.y*0.6)
		for control in ["StartGame","ContinueGame","SelectLevel","HowToPlay"]:
			assert(hero.get_global_rect().encloses(home.find_child(control,true,false).get_global_rect()))
		assert(home.find_child("GameGuide",true,false)==null)
		assert(home.find_child("HomeWelcomeTitle",true,false).text==manager.text("Welcome"))
		assert(home.find_child("StartGame",true,false)!=null)
		assert(home.find_child("ContinueGame",true,false).disabled)
		var settings=home.find_child("Settings",true,false)
		assert(settings.size.x<=60 and settings.size.y<=50)
		var language_back=home.find_child("BackToLanguage",true,false)
		assert(language_back!=null and language_back.icon!=null)
		language_back.pressed.emit()
		await _wait()
		picker=menu.find_child("LanguageSelectionScreen",true,false)
		assert(picker!=null)
		assert(picker.find_child("LanguageContinue",true,false).text=="Continue   →")
		picker.find_child("LanguageContinue",true,false).pressed.emit()
		await _wait()
		menu.call("_show_levels")
		await _wait()
		var screen=menu.find_child("LevelSelectionScreen",true,false)
		assert(screen!=null)
		assert(screen.find_child("MissionBrief",true,false)==null)
		var cards=screen.find_children("StageCard*","Button",true,false)
		assert(cards.size()==10)
		assert(screen.find_children("StageStars","Control",true,false).size()==3)
		assert(screen.find_children("SelectedStageTag","Panel",true,false).size()==1)
		assert(screen.find_child("LevelJourneyBestStars",true,false).get_meta("stars")==0)
		assert(screen.find_child("LevelJourneyCompleted",true,false).get_meta("completed")==0)
		assert(screen.find_children("SelectedPlayButton","Button",true,false).size()==1)
		assert(screen.find_children("SelectedStageGlow","Panel",true,false).size()==1)
		assert(screen.find_child("SelectedStageTag",true,false).z_index>screen.find_child("SelectedStageOutline",true,false).z_index)
		for card in cards:
			assert(card.disabled==(int(card.get_meta("stage"))>3))
			var title=card.find_child("StageTitle",true,false)
			assert(card.find_child("StageSymbol",true,false)!=null)
			assert((card.find_child("StageLock",true,false)!=null)==card.disabled)
			var caption=card.find_child("StageCaption",true,false)
			assert(caption.position.y+caption.size.y<=204)
			assert(title.position.y>=0 and title.position.y+title.size.y<=title.get_parent().size.y+0.1)
			var play=card.find_child("SelectedPlayButton",true,false)
			if play!=null:
				assert(card.size.y-play.position.y-play.size.y>=12)
				assert(caption.position.y+caption.size.y<=play.position.y)
		# Actual picture clicks must reach the card beneath its decorative children.
		var level_image=screen.find_child("StageCard02",true,false).find_child("StageThumbnail",true,false)
		for pressed in [true,false]:
			var level_click:=InputEventMouseButton.new()
			level_click.button_index=MOUSE_BUTTON_LEFT
			level_click.pressed=pressed
			level_click.position=level_image.get_global_rect().get_center()
			root.push_input(level_click,true)
			await process_frame
		await _wait()
		assert(screen.find_child("StageCard02",true,false).find_child("SelectedPlayButton",true,false)!=null)
		assert(screen.find_children("SelectedPlayButton","Button",true,false).size()==1)
		for button in screen.find_children("*","Button",true,false): assert(button.text!=manager.text("Trainee"))
		var level_back=screen.find_child("BackFromLevels",true,false)
		assert(level_back!=null and level_back.icon!=null)
		level_back.pressed.emit()
		await _wait()
		assert(menu.find_child("KitchenHomeScreen",true,false)!=null)
		menu.call("_show_levels")
		await _wait()
		_collect(menu,"levels")
		for page in ["_show_help","_show_settings","_show_profile","_show_progress","_show_achievements","_show_missions"]:
			menu.call(page)
			await _wait()
			_collect(menu,page)
			if page=="_show_settings":
				var settings_page=menu.find_child("KitchenSettingsScreen",true,false)
				var settings_card=settings_page.find_child("SettingsCard",true,false)
				var settings_home=settings_page.find_child("SettingsHome",true,false)
				assert(settings_page.get_global_rect().encloses(settings_card.get_global_rect()))
				assert(settings_card.get_global_rect().end.y<settings_home.global_position.y)
				for item in settings_card.find_children("*","Control",true,false):
					if item is Label or item is Button or item is HSlider:
						assert(settings_card.get_global_rect().encloses(item.get_global_rect()))
				var extras=load("res://MenuExtras.gd")
				var old_volume: float=extras.volume()
				settings_page.find_child("SettingsVolume",true,false).value=0.4
				assert(is_equal_approx(extras.volume(),0.4))
				settings_page.find_child("SettingsVolume",true,false).value=old_volume
				var old_mute: bool=extras.muted()
				var mute=settings_page.find_child("SettingsMute",true,false)
				mute.button_pressed=not old_mute
				assert(extras.muted()!=old_mute)
				mute.button_pressed=old_mute
				var settings_languages=settings_page.find_child("SettingsLanguages",true,false)
				settings_languages.find_child("LanguageMenu",true,false).get_popup().id_pressed.emit(1)
				await _wait()
				assert(Progress.get_language()=="mm")
				var original_index: int=["jp","mm","en"].find(language)
				settings_page.find_child("SettingsLanguages",true,false).find_child("LanguageMenu",true,false).get_popup().id_pressed.emit(original_index)
				await _wait()
				assert(Progress.get_language()==language)
		# Select a card and launch through its visible Play control.
		menu.call("_show_levels")
		await _wait()
		var level_screen=menu.find_child("LevelSelectionScreen",true,false)
		level_screen.find_child("StageCard01",true,false).pressed.emit()
		await _wait()
		level_screen.find_child("StageCard01",true,false).find_child("SelectedPlayButton",true,false).pressed.emit()
		await _wait()
		var game=current_scene
		assert(game.get("current_lang")==language)
		assert(game.get("canvas")!=null)
		assert(game.find_child("MintWorkspace",true,false)!=null)
		var reach=game.find_child("LevelReachBar",true,false)
		assert(reach!=null)
		var active_header=game.find_child("Stage1Header",true,false)
		var header_language=active_header.find_child("LanguageMenu",true,false)
		assert(header_language is MenuButton and header_language.icon!=null and header_language.get_popup().item_count==3)
		var language_popup_style:=header_language.get_popup().get_theme_stylebox("panel") as StyleBoxFlat
		assert(language_popup_style!=null and language_popup_style.bg_color.get_luminance()>0.8)
		assert(active_header.find_child("GameHomeButton",true,false).icon!=null)
		assert(active_header.get_global_rect().encloses(reach.get_global_rect()))
		assert(active_header.find_child("StageRibbon",true,false)==null)
		assert(active_header.find_child("CurrentStageLabel",true,false).text==manager.text("Stage %d")%1)
		assert(reach.find_child("ReachNode01",true,false).get_global_rect().encloses(reach.find_child("CurrentStageLabel",true,false).get_global_rect()))
		for heading in active_header.find_children("*","Label",true,false):assert(heading.text!=manager.text("LDK Boundary Drawing"))
		var active_point=reach.find_child("ReachNode01",true,false)
		var small_point=reach.find_child("ReachNode04",true,false)
		assert(active_point.size.x>small_point.size.x)
		for n in range(2,11):
			var inactive_point=reach.find_child("ReachNode%02d"%n,true,false)
			assert(absf(inactive_point.size.x-small_point.size.x)<=1)
			assert(is_equal_approx(inactive_point.size.y,small_point.size.y))
		assert(reach.find_children("ReachNode*","Control",true,false).size()==10)
		for n in range(1,11):
			var point=reach.find_child("ReachNode%02d"%n,true,false)
			assert(point.get_meta("locked")== (not Progress.is_level_unlocked(n)))
			assert(point.get_meta("current")== (n==1))
		assert(game.find_child("Stage1Hint",true,false)==null)
		assert(not game.find_child("CustomerVoiceControls",true,false).is_visible_in_tree())
		assert(game.find_child("Stage1PauseButton",true,false)==null)
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		var customer_name: String = game.get("speaker_name_label").text
		assert(customer_name==manager.text("Ms. Hosokawa"))
		var workspace=game.find_child("Stage1WorkspaceSplit",true,false)
		var customer_card=game.find_child("Stage1CustomerCard",true,false)
		var drawing_card=game.find_child("Stage1DrawingCard",true,false)
		assert(game.find_child("Stage1Header",true,false).size.y<=58)
		assert(game.find_child("Stage1Logo",true,false).texture.resource_path=="res://LoadingAssets/KitchenLogo.webp")
		var avatar=game.find_child("Stage1CustomerAvatar",true,false)
		var stage_one_avatar_size: Vector2 = avatar.size
		var name_plate=game.find_child("Stage1CustomerIdentity",true,false)
		assert(name_plate.global_position.y>=avatar.get_global_rect().end.y)
		assert(name_plate.get_global_rect().encloses(game.get("speaker_name_label").get_global_rect()))
		var request_header=game.find_child("CustomerRequestHeader",true,false)
		var customer_frame=name_plate.get_theme_stylebox("panel").texture.resource_path
		var request_frame=request_header.get_theme_stylebox("panel").texture.resource_path
		assert(customer_frame!=request_frame and request_frame=="res://UIAssets/request-tab.svg")
		assert(request_header.visible)
		var request: RichTextLabel=game.get("request_label")
		assert(request.text.count("• ")==4)
		assert(request.get_content_height()<=game.get("dialog_scroll").size.y+2)
		for line in request.text.split("\n"): assert(line.begins_with("• "))
		assert(request_header.get_global_rect().end.y<=game.get("dialog_bubble").global_position.y)
		assert(game.find_child("CustomerAnswerBadge",true,false).get_parent().get_parent()==game.get("dialog_bubble"))
		for tool in game.find_child("Stage1SixToolGroup",true,false).get_children():
			assert(tool.size.y<=40)
			assert(drawing_card.get_global_rect().encloses(tool.get_global_rect()))
		assert(absf(customer_card.size.x/workspace.size.x-0.35)<0.025)
		assert(not customer_card.get_global_rect().intersects(drawing_card.get_global_rect()))
		for card_name in ["Stage1CustomerCard","Stage1ReferenceCard","Stage1DrawingCard"]:
			assert(game.get_global_rect().encloses(game.find_child(card_name,true,false).get_global_rect()))
		# Exercise the visible Stage 1 controls, including the two distinct Resets.
		var drawing=game.get("canvas")
		var live_retry=game.find_child("Stage1Retry",true,false)
		assert(live_retry!=null and live_retry.is_visible_in_tree())
		var wall=PackedVector2Array([Vector2.ZERO,Vector2(1000,0)])
		drawing.lines.append(wall)
		game.find_child("Stage1ToolUndo",true,false).pressed.emit()
		assert(drawing.lines.is_empty())
		game.find_child("Stage1ToolRedo",true,false).pressed.emit()
		assert(drawing.lines.size()==1)
		drawing.lines.append(wall)
		drawing.selected_line_index=0
		game.find_child("Stage1ToolDelete",true,false).pressed.emit()
		assert(drawing.lines.size()==1)
		game.find_child("Stage1ToolDeleteLast",true,false).pressed.emit()
		assert(drawing.lines.is_empty())
		drawing.lines.append(wall)
		game.find_child("Stage1ToolZoomIn",true,false).pressed.emit()
		assert(drawing.zoom_level>1.0)
		game.find_child("Stage1ToolZoomOut",true,false).pressed.emit()
		assert(is_equal_approx(drawing.zoom_level,1.0))
		drawing.pan=Vector2(200,200)
		game.find_child("Stage1ResetView",true,false).pressed.emit()
		assert(drawing.pan==Vector2(72,60) and drawing.lines.size()==1)
		game.find_child("Stage1ResetDrawing",true,false).pressed.emit()
		assert(drawing.lines.is_empty() and drawing.drawing_enabled)
		game.find_child("Stage1CheckAnswer",true,false).pressed.emit()
		await _wait()
		assert(game.get("last_eval_state")=="wrong")
		assert(game.find_child("CustomerAnswerLabel",true,false).text==manager.text("Incorrect"))
		var wrong_tint=game.get("dialog_bubble").get_meta("tint_strength")
		assert(wrong_tint>0.0 and wrong_tint<0.1)
		assert(game.get("dialog_bubble").get_theme_stylebox("panel").bg_color.r>game.get("dialog_bubble").get_theme_stylebox("panel").bg_color.g)
		assert(game.get("again_button_row").visible)
		for control_name in ["Stage1DrawingToolbar","Stage1ResetDrawing","Stage1CheckAnswer"]:
			var control=game.find_child(control_name,true,false)
			assert(drawing_card.get_global_rect().encloses(control.get_global_rect()))
		assert(drawing_card.get_global_rect().encloses(game.get("again_button").get_global_rect()))
		game.get("again_button").pressed.emit()
		assert(game.get("last_eval_state")=="none" and not drawing.drawing_enabled)
		assert(not game.get("conversation_finished") and game.get("ok_button").disabled)
		assert(live_retry.is_visible_in_tree() and drawing.lines.is_empty())
		# Language changes must not restore the old, hard-coded customer name.
		var alternate_language="jp" if language!="jp" else "en"
		header_language.get_popup().id_pressed.emit(["jp","mm","en"].find(alternate_language))
		await _wait()
		assert(game.get("speaker_name_label").text==manager.text("Ms. Hosokawa"))
		header_language.get_popup().id_pressed.emit(["jp","mm","en"].find(language))
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		assert(game.get("speaker_name_label").text==customer_name)
		_collect(game,"stage1")
		# The real six-wall validator must reject a 1 mm error and accept the exact plan.
		var vertices := [Vector2(0,0),Vector2(7380,0),Vector2(7380,2360),Vector2(7680,2360),Vector2(7680,3400),Vector2(0,3400)]
		drawing.lines.clear()
		for i in range(6): drawing.lines.append(PackedVector2Array([vertices[i],vertices[(i+1)%6]]))
		drawing.lines[0][1].x += 1
		assert(not drawing.analyze_reference())
		drawing.lines[0][1].x -= 1
		assert(drawing.analyze_reference())
		game.call("_confirm")
		assert(game.find_child("CustomerAnswerLabel",true,false).text==manager.text("Correct"))
		assert(game.get("dialog_bubble").get_meta("tint_strength")==wrong_tint)
		assert(game.find_child("Stage1CompleteOverlay",true,false)==null)
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await create_timer(0.5).timeout
		assert(Progress.is_completed(1))
		assert(reach.find_child("ReachNode01",true,false).get_meta("completed"))
		var complete=game.find_child("Stage1CompleteOverlay",true,false)
		assert(complete!=null and current_scene==game)
		assert(complete.find_child("CompletionBlueprintGraphic",true,false)!=null)
		assert(complete.find_child("CelebrationArtwork",true,false)==null)
		assert(complete.find_child("CompletionConfetti",true,false).mouse_filter==Control.MOUSE_FILTER_IGNORE)
		assert(complete.find_child("MissionCompleteCard",true,false).size.x>complete.find_child("MissionCompleteCard",true,false).size.y*1.4)
		assert(complete.find_child("CompletionHome",true,false)!=null)
		assert(complete.find_child("CompletionTitle",true,false).text==manager.text("Stage %d complete!")%1)
		assert(complete.find_child("CompletionMission",true,false).text==manager.text("LDK Boundary Drawing"))
		assert(complete.find_child("CompletionRetry",true,false)!=null)
		assert(complete.find_child("CompletionTime",true,false)!=null)
		assert(complete.find_child("CompletionMistakes",true,false)!=null)
		assert(complete.find_child("CompletionRating",true,false)!=null)
		for field in ["Time","Mistakes"]:
			assert(complete.find_child("Completion"+field+"Card",true,false).get_global_rect().encloses(complete.find_child("Completion"+field,true,false).get_global_rect()))
		for i in range(1,4):assert(complete.find_child("ResultStar%d"%i,true,false)!=null)
		assert(game.get_global_rect().encloses(complete.find_child("MissionCompleteCard",true,false).get_global_rect()))
		assert(complete.find_child("CompletionReview",true,false)==null)
		if language=="mm":
			complete.find_child("CompletionHome",true,false).pressed.emit()
			await _wait()
			assert(current_scene.find_child("KitchenHomeScreen",true,false)!=null)
			assert(current_scene.find_child("LanguageSelectionScreen",true,false)==null)
			assert(Progress.resume_stage()==2 and Progress.is_completed(1))
			current_scene.find_child("ContinueGame",true,false).pressed.emit()
		else:
			complete.next_requested.emit()
		await _wait()
		game=current_scene
		assert(game.get("current_lang")==language)
		game.call("_stop_voice")
		game.call("_on_voice_finished")
		await _wait()
		assert(game.get("name_label").text==customer_name)
		assert(game.find_child("MintWorkspace",true,false)!=null)
		var qa_card=game.find_child("Stage2AnswerCard",true,false)
		var qa_header=game.find_child("GameHeader",true,false)
		var qa_reach=game.find_child("LevelReachBar",true,false)
		assert(qa_header.get_global_rect().encloses(qa_reach.get_global_rect()))
		assert(qa_header.find_child("CurrentStageLabel",true,false).text==manager.text("Stage %d")%2)
		assert(qa_reach.find_child("ReachNode02",true,false).get_global_rect().encloses(qa_reach.find_child("CurrentStageLabel",true,false).get_global_rect()))
		assert(game.find_child("Stage2QATitle",true,false).text==manager.text("Plan Q&A"))
		assert(game.find_child("CustomerNamePlate",true,false).get_theme_stylebox("panel").texture.resource_path==customer_frame)
		assert(game.find_child("CustomerRequestHeader",true,false).get_theme_stylebox("panel").texture.resource_path==request_frame)
		assert(game.find_child("CustomerAnswerBadge",true,false).get_parent().get_parent()==game.find_child("CustomerConversation",true,false))
		assert(game.get("answer_input").size.y/qa_card.size.y>0.6)
		assert(game.get("submit_button").text=="OK")
		assert(game.find_child("Stage2Retry",true,false)!=null and game.find_child("Stage2Retry",true,false).is_visible_in_tree())
		assert(game.get("progress_description").text==manager.text("Type your answer, then press OK."))
		assert(qa_card.get_global_rect().encloses(game.get("submit_button").get_global_rect()))
		assert(qa_card.get_global_rect().encloses(game.get("progress_card").get_global_rect()))
		var finished_point=qa_reach.find_child("ReachNode01",true,false)
		var locked_point=qa_reach.find_child("ReachNode04",true,false)
		assert(finished_point.get_meta("completed"))
