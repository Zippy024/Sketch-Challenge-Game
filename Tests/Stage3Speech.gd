extends SceneTree
const Progress=preload("res://GameProgress.gd")
const Speech=preload("res://CustomerSpeech.gd")
func _initialize() -> void:call_deferred("_run")
func _wait(seconds: float=0.25) -> void:await create_timer(seconds).timeout
func _run() -> void:
	for language in ["en","mm","jp"]:
		if current_scene and current_scene.has_method("_suspend_session_save"):current_scene.call("_suspend_session_save")
		Progress.reset_progress()
		Progress.set_language(language)
		Progress.open_stage(3)
		change_scene_to_file("res://stage_3.tscn")
		await _wait()
		var game=current_scene
		for phase in range(3):
			var speech=game.find_child("CustomerSpeech",true,false)
			assert(speech!=null and speech.player.playing)
			assert(speech.player.stream.resource_path==Speech.voice_path(language,phase))
			assert(speech.player.stream.get_length()>2.0)
			assert(speech.caption.text.contains(game.get_script().get_script_constant_map()["QUESTIONS"][language][phase]))
			speech.player.seek(speech.player.stream.get_length()*0.4)
			await _wait(0.12)
			assert(speech.caption.visible_ratio>0.1 and speech.caption.visible_ratio<0.9)
			assert(speech.find_child("SpeakingMeter",true,false).speaking)
			speech.toggle_pause()
			var visible: int=speech.caption.visible_characters
			await _wait(0.15)
			assert(speech.player.stream_paused and speech.caption.visible_characters==visible)
			assert(not speech.find_child("SpeakingMeter",true,false).speaking)
			speech.toggle_pause()
			assert(not speech.player.stream_paused)
			if phase==0:
				game.call("_open_game_menu")
				await _wait(0.15)
				assert(paused and speech.player.stream_paused)
				game.call("_resume_from_game_menu")
				assert(not paused and not speech.player.stream_paused)
				speech.toggle_pause()
				game.call("_open_game_menu")
				game.call("_resume_from_game_menu")
				assert(speech.player.stream_paused)
				speech.replay_question()
				assert(not speech.player.stream_paused and speech.caption.visible_characters==2)
			# The question must finish with speech, before the recordings' silent tails.
			var last= speech.get("_reveal_cues").back()
			assert(float(last.end)<speech.player.stream.get_length()-0.5)
			speech.player.seek(float(last.end)+0.1)
			await _wait(0.12)
			assert(speech.caption.visible_ratio==1.0)
			if speech.get("_reveal_cues").size()==2:
				var cues=speech.get("_reveal_cues")
				speech.call("_reveal_at",float(cues[0].end)+0.01)
				assert(speech.caption.visible_characters==int(cues[0].to))
				speech.call("_reveal_at",float(cues[1].start)-0.01)
				assert(speech.caption.visible_characters==int(cues[0].to))
			speech.player.seek(speech.player.stream.get_length()-0.08)
			await _wait(0.4)
			assert(speech.caption.visible_characters==-1)
			assert(not speech.find_child("SpeakingMeter",true,false).speaking)
			if phase<2:
				var old_player: WeakRef=weakref(speech.player)
				game.call("_choose",2 if phase==0 else 1)
				await _wait(1.1)
				assert(old_player.get_ref()==null)
				assert(not game.find_child("CustomerAnswerBadge",true,false).visible)
				assert(game.get("_transitioning") and not game.get("_speech").player.playing)
				await _wait(0.3)
				assert(game.get("_transitioning"))
				assert(game.find_child("Stage3PhaseContinue",true,false)==null)
				while game.get("_transitioning"):await _wait(0.1)
				await _wait(0.1)
		var speech=game.find_child("CustomerSpeech",true,false)
		game.call("_open_answer",0,true)
		game.call("_submit_part_answer","カウンター")
		await _wait(0.8)
		assert(game.find_child("CustomerSpeech",true,false)==speech and not speech.player.playing)
	print("STAGE3_SPEECH_OK: nine recordings, exact questions, recorded speech-window subtitle reveal, pause/replay, menu pause, section replacement, no per-answer replay")
	quit()
